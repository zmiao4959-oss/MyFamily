# Local server
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
APP_SECRET=replace-with-a-long-random-secret
PAIRING_TOKEN=
MEDIA_ROOT=/data/media
BACKUP_ROOT=/data/backups
MAX_UPLOAD_SIZE_MB=500

# Database
POSTGRES_DB=family_memory
POSTGRES_USER=family_memory
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://family_memory:replace-with-a-strong-database-password@postgres:5432/family_memory

# DeepSeek (optional; basic features work without a key)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
DEEPSEEK_MAIN_MODEL=deepseek-v4-pro
AI_REQUEST_TIMEOUT_SECONDS=60

# Volcano Ark (reserved for phase 6 multimodal search)
VOLCANO_ARK_API_KEY=
VOLCANO_ARK_BASE_URL=
VOLCANO_EMBEDDING_MODEL=doubao-embedding-vision-251215
VOLCANO_EMBEDDING_ENDPOINT_ID=
VOLCANO_IMAGE_MODEL=
VOLCANO_IMAGE_ENDPOINT_ID=

# Feature flags
FEATURE_AI=false
FEATURE_MULTIMODAL_SEARCH=false
FEATURE_SYSTEM_ASR=true
FEATURE_LOCAL_OFFLINE_ASR=false
FEATURE_CLOUD_ASR=false
FEATURE_IN_APP_IMAGE_GENERATION=false
FEATURE_PUBLIC_PROFILE=false
FEATURE_MULTI_USER=false
